# ============================================
# TrustRAG Backend Environment Variables
# ============================================

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# Database (MongoDB Atlas Free Tier or Local)
# Atlas format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/trustrag?retryWrites=true&w=majority
# Local format: mongodb://127.0.0.1:27017/trustrag
MONGODB_URI=mongodb://127.0.0.1:27017/trustrag

# JWT Secret for User Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AI Service (FastAPI running locally or on Render/Railway free tier)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=120000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Backblaze B2 S3-compatible object storage
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=trustrag-documents-00
