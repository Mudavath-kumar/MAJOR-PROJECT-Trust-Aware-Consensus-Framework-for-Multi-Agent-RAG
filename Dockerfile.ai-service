# ─── TrustRAG AI Service — Production Dockerfile ────────────────────────────
# Lightweight: no torch, no sentence-transformers — embeddings via Gemini API
# RAM usage: ~150MB (fits Render free tier 512MB)
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libffi-dev \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY ai-service/requirements.txt ./requirements.txt

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY ai-service/ ./

RUN useradd -m -u 1001 trustrag && chown -R trustrag:trustrag /app
USER trustrag

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
