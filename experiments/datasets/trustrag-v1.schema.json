{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrustRAG labelled evaluation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "dataset_version",
    "question",
    "answer_type",
    "gold_answer",
    "gold_evidence_ids",
    "documents",
    "source_dataset",
    "challenge",
    "review"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "answer_type": {
      "type": "string",
      "enum": ["answerable", "unanswerable", "conflicting", "prompt_injection"]
    },
    "gold_answer": {"type": "string"},
    "gold_evidence_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "snapshot_sha256"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "source_dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "split", "record_id", "license"],
      "properties": {
        "name": {"const": "HotpotQA"},
        "split": {"const": "distractor/validation"},
        "record_id": {"type": "string", "minLength": 1},
        "license": {"const": "CC BY-SA 4.0"}
      }
    },
    "challenge": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["synthetic", "intervention"],
          "properties": {
            "synthetic": {"const": true},
            "intervention": {
              "type": "string",
              "enum": [
                "remove-supporting-passages-from-query-scope",
                "add-alternative-answer-claim",
                "add-untrusted-instruction-document"
              ]
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_a", "reviewer_b", "resolution"],
      "properties": {
        "reviewer_a": {"enum": ["pending", "approved", "rejected"]},
        "reviewer_b": {"enum": ["pending", "approved", "rejected"]},
        "resolution": {"enum": ["pending", "resolved"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"answer_type": {"enum": ["answerable", "prompt_injection"]}}},
      "then": {
        "properties": {
          "gold_answer": {"type": "string", "minLength": 1},
          "gold_evidence_ids": {"type": "array", "minItems": 1}
        }
      }
    }
  ]
}
