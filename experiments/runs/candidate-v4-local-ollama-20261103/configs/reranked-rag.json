{
  "name": "reranked-rag",
  "dataset_version": "trustrag-v1",
  "system": "vanilla-rag-with-reranking",
  "model": "qwen2.5-coder:3b",
  "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
  "prompt_version": "reranked-v1",
  "temperature": 0.1,
  "retrieval": {
    "top_k": 5,
    "candidate_k": 20,
    "chunk_size": 400,
    "chunk_overlap": 80,
    "reranking": {
      "enabled": true,
      "strategy": "hybrid-lexical-semantic-v1"
    },
    "external_verification": false
  },
  "orchestration": {
    "mode": "single-pass"
  },
  "verification": {
    "mode": "none"
  },
  "decision": {
    "typed_verification": false,
    "abstention_gate": false
  },
  "seed": 42
}
