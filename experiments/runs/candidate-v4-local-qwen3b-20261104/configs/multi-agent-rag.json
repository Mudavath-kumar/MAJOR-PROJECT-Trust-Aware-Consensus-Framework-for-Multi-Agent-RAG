{
  "name": "multi-agent-rag",
  "dataset_version": "trustrag-v1",
  "system": "multi-agent-without-decision-gate",
  "model": "qwen2.5-coder:3b",
  "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
  "prompt_version": "multi-agent-v1",
  "temperature": 0.1,
  "retrieval": {
    "top_k": 5,
    "chunk_size": 400,
    "chunk_overlap": 80,
    "reranking": {
      "enabled": false
    },
    "external_verification": false
  },
  "orchestration": {
    "mode": "fixed-multi-agent"
  },
  "verification": {
    "mode": "typed-claims"
  },
  "decision": {
    "typed_verification": true,
    "abstention_gate": false
  },
  "seed": 42
}
