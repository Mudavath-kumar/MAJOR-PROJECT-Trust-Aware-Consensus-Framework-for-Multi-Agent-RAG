{
  "name": "rag-verification",
  "dataset_version": "trustrag-v1",
  "system": "single-pass-rag-with-typed-verification",
  "model": "ollama/qwen2.5-coder:1.5b",
  "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
  "prompt_version": "rag-verification-v1",
  "temperature": 0.1,
  "retrieval": {
    "top_k": 5,
    "chunk_size": 400,
    "chunk_overlap": 80,
    "reranking": {
      "enabled": false
    },
    "external_verification": false
  },
  "orchestration": {
    "mode": "single-pass"
  },
  "verification": {
    "mode": "typed-claims"
  },
  "decision": {
    "typed_verification": true,
    "abstention_gate": false
  },
  "seed": 42
}
