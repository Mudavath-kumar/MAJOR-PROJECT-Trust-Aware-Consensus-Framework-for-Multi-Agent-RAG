# ============================================
# TrustRAG AI Service — Environment Variables
# 100% Free Stack Configuration
# ============================================

PORT=8000
HOST=0.0.0.0

# ── Google Gemini FREE LLM ─────────────────────────────────────────────────
# ✅ 100% Free — No credit card required
# Get key at: https://aistudio.google.com/app/apikey
# Free limits: 15 RPM, 1 million tokens/day
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter fallback/alternative provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=TrustRAG

# ── Local Ollama Fallback (100% free, offline) ─────────────────────────────
# Install from: https://ollama.ai/download
# Run: ollama pull llama3.2
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Optional: Tavily Web Search ─────────────────────────────────────────────
# Free: 1000 queries/month — https://tavily.com
TAVILY_API_KEY=
EXTERNAL_VERIFICATION_ENABLED=true

# ── Vector Store & Embeddings ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
