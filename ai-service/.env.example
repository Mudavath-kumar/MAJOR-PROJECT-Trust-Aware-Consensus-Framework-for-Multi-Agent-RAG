# ============================================
# TrustRAG AI Service — Environment Variables
# 100% Free Stack Configuration
# ============================================

PORT=8000
HOST=0.0.0.0
AI_SERVICE_TOKEN=replace-with-the-same-secret-used-by-backend

# Local-only model mode. Keep `auto` for the configured Gemini/OpenRouter route.
LLM_PROVIDER=auto
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=600

# ── Google Gemini FREE LLM ─────────────────────────────────────────────────
# ✅ 100% Free — No credit card required
# Get key at: https://aistudio.google.com/app/apikey
# Free limits: 15 RPM, 1 million tokens/day
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter alternative provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=TrustRAG

# GroqCloud free tier (separate from xAI's GROK_API_KEY).
# Select LLM_PROVIDER=groq_free only after adding a GroqCloud key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Optional: Tavily Web Search ─────────────────────────────────────────────
# Free: 1000 queries/month — https://tavily.com
TAVILY_API_KEY=
EXTERNAL_VERIFICATION_ENABLED=true

# ── Vector Store & Embeddings ──────────────────────────────────────────────
EMBEDDING_MODEL_NAME=gemini-embedding-2
MONGODB_URI=mongodb://127.0.0.1:27017/trustrag
